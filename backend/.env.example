# Gritty API server configuration (all optional).

# Port the HTTP server listens on.
PORT=8000

# Repo root the server operates on. Created (scaffolded) on startup if absent.
GRITTY_DATA_DIR=./data

# Allowed CORS origin. Leave unset to allow all ("*") outside production;
# in production (NODE_ENV=production) an unset value disables CORS entirely.
# Example: CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=

# Optional commit identity (falls back to the OS username otherwise).
# GRITTY_AUTHOR_NAME=Your Name
# GRITTY_AUTHOR_EMAIL=you@example.com
